rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function superOwner() {
      return signedIn()
        && request.auth.uid == '8YRBWWMKG2OUW6cmzZkGbFgOqyp2';
    }

    function examOwner() {
      return signedIn() && (
        superOwner()
        || request.auth.uid == 'rdP0ZXzSP9fGzmJshEVvbOfb31g2'
        || (
          exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', '') == 'owner'
        )
      );
    }

    function owner() {
      return examOwner()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', '') in ['owner', 'editor']
        );
    }

    function editorHasPermission(permission) {
      let rolePath = /databases/$(database)/documents/roles/$(request.auth.uid);
      return signedIn()
        && exists(rolePath)
        && get(rolePath).data.get('role', '') == 'editor'
        && get(rolePath).data.get('permissions', {}).get(permission, false) == true;
    }

    function canReviewExam() {
      return examOwner() || editorHasPermission('examReview');
    }

    function canEditQuizDrafts() {
      return editorHasPermission('quizDrafts');
    }

    function canSendNotifications() {
      return examOwner() || editorHasPermission('notifications');
    }

    function canManageMedia() {
      return examOwner() || editorHasPermission('media');
    }

    function examEnabled(mode) {
      let p = /databases/$(database)/documents/examConfig/current;
      return exists(p)
        && get(p).data.get('examPortalVisible', true) != false
        && (
          (mode == 'quiz' && get(p).data.get('dailyQuizVisible', true) != false)
          || (mode == 'mock1' && get(p).data.get('mockVisible', true) != false && get(p).data.get('mock1Visible', true) != false)
          || (mode == 'mock2' && get(p).data.get('mockVisible', true) != false && get(p).data.get('mock2Visible', true) != false)
          || (mode == 'main' && get(p).data.get('mainExamVisible', true) != false)
        );
    }

    function examStarted(fieldName) {
      let p = /databases/$(database)/documents/examConfig/current;
      return exists(p)
        && get(p).data.get(fieldName, null) is timestamp
        && request.time >= get(p).data.get(fieldName, timestamp.date(1970, 1, 1));
    }

    function gmailVerifiedStudent() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && exists(p)
        && get(p).data.get('gmailVerified', false) == true
        && request.auth.token.firebase.identities['google.com'] != null;
    }

    function confirmedExamStudent() {
      let p = /databases/$(database)/documents/examEnrolledStudents/$(request.auth.uid);
      return gmailVerifiedStudent()
        && exists(p)
        && get(p).data.get('verificationStatus', '') == 'confirmed'
        && get(p).data.get('rollNumber', '') is string
        && get(p).data.get('rollNumber', '') != ''
        && !get(p).data.get('rollNumber', '').matches('^BIS-.*$');
    }

    function validPhone(phone) {
      return phone is string && phone.matches('^[6-9][0-9]{9}$');
    }

    function validInviteId(inviteId) {
      return inviteId is string
        && inviteId.matches('^phone_\\+91[6-9][0-9]{9}$');
    }

    function matchingMobileIndex(phone, uid) {
      let p = /databases/$(database)/documents/mobileIndex/$(phone);
      return validPhone(phone)
        && exists(p)
        && get(p).data.get('uid', '') == uid;
    }

    function validPendingInvite(inviteId, uid) {
      let p = /databases/$(database)/documents/pending_editors/$(inviteId);
      return validInviteId(inviteId)
        && exists(p)
        && get(p).data.get('status', '') == 'pending'
        && get(p).data.get('targetUid', '') == uid
        && get(p).data.get('phoneE164', '') == '+91' + get(p).data.get('phone', '')
        && matchingMobileIndex(get(p).data.get('phone', ''), uid);
    }

    match /roles/{uid} {
      allow read: if examOwner() || (signedIn() && request.auth.uid == uid);
      
      allow create: if superOwner()
        && request.resource.data.get('role', '') in ['owner', 'editor'];

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.get('role', '') == 'editor'
        && request.resource.data.keys().hasOnly([
          'role', 'fullName', 'phone', 'email', 'permissions',
          'invitationId', 'createdAt'
        ])
        && validInviteId(request.resource.data.get('invitationId', ''))
        && validPendingInvite(request.resource.data.get('invitationId', ''), uid)
        && getAfter(
          /databases/$(database)/documents/pending_editors/$(request.resource.data.get('invitationId', ''))
        ).data.get('status', '') == 'claimed'
        && getAfter(
          /databases/$(database)/documents/pending_editors/$(request.resource.data.get('invitationId', ''))
        ).data.get('claimedUid', '') == uid
        && request.resource.data.get('permissions', {}) is map
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 254;

      allow update, delete: if examOwner();
    }

    match /pending_editors/{inviteId} {
      allow read: if examOwner()
        || (
          signedIn()
          && resource.data.get('targetUid', '') == request.auth.uid
          && matchingMobileIndex(resource.data.get('phone', ''), request.auth.uid)
        );

      allow create: if examOwner()
        && validInviteId(inviteId)
        && request.resource.data.get('status', '') == 'pending'
        && validPhone(request.resource.data.get('phone', ''))
        && request.resource.data.get('phoneE164', '') == '+91' + request.resource.data.get('phone', '')
        && inviteId == 'phone_' + request.resource.data.get('phoneE164', '')
        && request.resource.data.get('targetUid', '') is string
        && matchingMobileIndex(
          request.resource.data.get('phone', ''),
          request.resource.data.get('targetUid', '')
        )
        && request.resource.data.get('fullName', '') is string
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('permissions', {}) is map;

      allow update: if examOwner()
        || (
          signedIn()
          && resource.data.get('targetUid', '') == request.auth.uid
          && matchingMobileIndex(resource.data.get('phone', ''), request.auth.uid)
          && resource.data.get('status', '') == 'pending'
          && (
            (
              request.resource.data.get('status', '') == 'claimed'
              && request.resource.data.get('claimedUid', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'claimedUid', 'claimedAt'
              ])
              && request.resource.data.get('phone', '') == resource.data.get('phone', '')
              && request.resource.data.get('phoneE164', '') == resource.data.get('phoneE164', '')
              && request.resource.data.get('permissions', {}) == resource.data.get('permissions', {})
            )
            ||
            (
              request.resource.data.get('status', '') == 'declined'
              && request.resource.data.get('declinedUid', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'declinedUid', 'declinedAt'
              ])
            )
          )
        );

      allow delete: if examOwner();
    }

    match /users/{uid} {
      allow read: if owner() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role', 'roles', 'isOwner'])
        && (
          request.resource.data.get('phoneVerified', false) != true
          || (
            request.auth.token.keys().hasAny(['phone_number'])
            && request.auth.token.phone_number == request.resource.data.get('phone', '')
          )
        )
        && (
          request.resource.data.get('gmailVerified', false) != true
          || request.auth.token.firebase.identities['google.com'] != null
        )
        && (
          !request.resource.data.keys().hasAny(['mobile'])
          || validPhone(request.resource.data.get('mobile', ''))
        );

      allow update: if owner() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'displayName', 'email', 'photoUrl',
          'rollNumber', 'mala', 'location', 'village',
          'phone', 'phoneVerified', 'phoneAuthVerifiedAt',
          'updatedAt', 'mobile', 'gmailVerified', 'createdAt',
          'presenceStatus', 'lastLoginAt', 'lastSeenAt',
          'verificationStatus', 'authProvider'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mobile'])
          || (
            validPhone(request.resource.data.get('mobile', ''))
            && getAfter(
              /databases/$(database)/documents/mobileIndex/$(request.resource.data.get('mobile', ''))
            ).data.get('uid', '') == uid
            && (
              !resource.data.keys().hasAny(['mobile'])
              || !existsAfter(
                /databases/$(database)/documents/mobileIndex/$(resource.data.get('mobile', ''))
              )
            )
          )
        )
        // Students cannot set, clear, or otherwise change their own
        // gmailVerified flag. Verification must be established by trusted code
        // or an owner; a Google sign-in token alone is not permission to edit it.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gmailVerified'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'phone', 'phoneVerified', 'phoneAuthVerifiedAt'
          ])
          || request.resource.data.get('phoneVerified', false) != true
          || (
            request.auth.token.keys().hasAny(['phone_number'])
            && request.auth.token.phone_number == request.resource.data.get('phone', '')
            && request.resource.data.get('phoneAuthVerifiedAt', null) is timestamp
          )
        )
      );

      allow delete: if owner();
    }

    match /mobileIndex/{mobile} {
      allow read: if owner()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid);

      allow create: if signedIn()
        && validPhone(mobile)
        && !exists(/databases/$(database)/documents/mobileIndex/$(mobile))
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.get('uid', '') == request.auth.uid;

      allow update: if false;

      allow delete: if signedIn()
        && validPhone(mobile)
        && resource.data.get('uid', '') == request.auth.uid;
    }

    match /settings/{id} {
      allow read: if id != 'rollCounter' || examOwner();
      allow write: if id == 'rollCounter' ? examOwner() : owner();
    }

    match /customExams/{examId} {
      allow read, create, update, delete: if examOwner();
    }


    match /examArchives/{archiveId} {
      allow read: if examOwner() || editorHasPermission('reports');
      allow create, update, delete: if examOwner();
      match /records/{recordId} {
        allow read: if examOwner() || editorHasPermission('reports');
        allow create, update, delete: if examOwner();
      }
    }

    match /examConfig/{id} {
      allow read: if true;
      allow write: if examOwner();
    }

    match /quiz/{questionId} {
      allow read: if examOwner()
        || canEditQuizDrafts()
        || (
          resource.data.get('published', false) == true
          && examEnabled('quiz')
          && examStarted('quizStartAt')
        );

      allow create: if examOwner() || (
        canEditQuizDrafts()
        && request.resource.data.get('published', false) == false
        && request.resource.data.get('status', '') == 'draft'
      );

      allow update: if examOwner() || (
        canEditQuizDrafts()
        && request.resource.data.get('published', false) == false
        && request.resource.data.get('status', '') == 'draft'
      );

      allow delete: if examOwner();
    }

    match /mainExamQuestions/{questionId} {
      allow read: if canReviewExam()
        || (
          resource.data.get('published', false) == true
          && examEnabled('main')
          && examStarted('mainStartAt')
        );
      allow create, update, delete: if examOwner();
    }

    match /mockExam_1/{questionId} {
      allow read: if canReviewExam()
        || (
          resource.data.get('published', false) == true
          && examEnabled('mock1')
          && examStarted('mock1StartAt')
        );
      allow create, update, delete: if examOwner();
    }

    match /mockExam_2/{questionId} {
      allow read: if canReviewExam()
        || (
          resource.data.get('published', false) == true
          && examEnabled('mock2')
          && examStarted('mock2StartAt')
        );
      allow create, update, delete: if examOwner();
    }

    match /examAnswerKeys/{examCollection}/items/{questionId} {
      allow read: if canReviewExam();
      allow write: if examOwner();
    }

    match /examDrafts/{id} {
      allow read, write: if owner()
        || (signedIn() && id.matches('^' + request.auth.uid + '_.*$'));
    }

    match /examEnrolledStudents/{uid} {
      allow read: if canReviewExam() || (signedIn() && request.auth.uid == uid);

      allow create: if examOwner() || (
        gmailVerifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.get('verificationStatus', '') == 'pending'
        && !request.resource.data.keys().hasAny(['rollNumber'])
      );

      allow update: if examOwner() || (
        gmailVerifiedStudent()
        && request.auth.uid == uid
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'name', 'phone', 'mobile',
          'dateOfBirth', 'examName', 'location',
          'email', 'updatedAt'
        ])
      );

      allow delete: if examOwner();
    }

    match /counters/{id} {
      allow read, write: if examOwner();
    }

    match /reviews/{reviewId} {
      allow read, create, update: if canReviewExam();
      allow delete: if examOwner();

      match /history/{historyId} {
        allow read, create: if canReviewExam();
        allow update, delete: if examOwner();
      }
    }

    match /publishedResults/{resultId} {
      // Main/mock results remain private until the Owner releases them. Daily quiz
      // results retain the existing per-document published status behavior.
      allow read: if examOwner() || (
        signedIn()
        && resource.data.get('uid', '') == request.auth.uid
        && (
          (resource.data.get('mode', '') == 'quiz'
            && resource.data.get('status', '') == 'published')
          || (
            exists(/databases/$(database)/documents/examConfig/current)
            && get(/databases/$(database)/documents/examConfig/current).data.get('resultsPublished', false) == true
          )
        )
      );

      allow create: if canReviewExam() || (
        signedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('mode', '') == 'quiz'
        && request.resource.data.get('status', '') == 'published'
        && request.resource.data.keys().hasOnly([
          'uid', 'sourceCollection', 'sourceSubmissionId',
          'mode', 'name', 'rollNumber', 'score', 'total',
          'status', 'feedback', 'publishedAt', 'publishedBy'
        ])
      );

      allow update, delete: if canReviewExam();
    }

    match /mainExamSubmissions/{attemptId} {
      allow create: if confirmedExamStudent()
        && examEnabled('main')
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('mode', '') == 'main'
        && examStarted('mainStartAt');

      allow read, update: if canReviewExam();
      allow delete: if examOwner();
    }

    match /mockExamSubmissions/{attemptId} {
      allow create: if confirmedExamStudent()
        && request.resource.data.get('uid', '') == request.auth.uid
        && (
          (request.resource.data.get('mode', '') == 'mock1' && examEnabled('mock1') && examStarted('mock1StartAt'))
          || (request.resource.data.get('mode', '') == 'mock2' && examEnabled('mock2') && examStarted('mock2StartAt'))
        );

      allow read, update: if canReviewExam();
      allow delete: if examOwner();
    }

    match /quizAttempts/{attemptId} {
      allow create: if confirmedExamStudent()
        && examEnabled('quiz')
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('mode', '') == 'quiz'
        && examStarted('quizStartAt');

      allow read, update: if canReviewExam();
      allow delete: if examOwner();
    }

    match /examSubmissions/{id} {
      allow read: if examOwner() || (
        signedIn()
        && (
          resource.data.get('uid', '') == request.auth.uid
          || resource.data.get('studentUid', '') == request.auth.uid
        )
      );

      allow create: if signedIn()
        && (
          request.resource.data.get('uid', '') == request.auth.uid
          || request.resource.data.get('studentUid', '') == request.auth.uid
        );

      allow update, delete: if examOwner();
    }

    match /examSessions/{sessionId} {
      function isOwnSession() {
        return signedIn()
          && sessionId.matches('^' + request.auth.uid + '_(quiz|mock1|mock2|main)$');
      }

      allow read: if examOwner()
        || isOwnSession()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid);

      allow create: if signedIn()
        && isOwnSession()
        && request.resource.data.get('uid', '') == request.auth.uid
        && sessionId == request.auth.uid + '_' + request.resource.data.get('mode', '')
        && examEnabled(request.resource.data.get('mode', ''))
        && (
          request.resource.data.get('status', '') == 'late_request'
          || (
            request.resource.data.get('status', '') == 'active'
            && exists(/databases/$(database)/documents/examConfig/current)
            && (
              (request.resource.data.get('mode', '') == 'quiz' && request.resource.data.get('endAt', null) == get(/databases/$(database)/documents/examConfig/current).data.get('quizEndAt', null))
              || (request.resource.data.get('mode', '') == 'mock1' && request.resource.data.get('endAt', null) == get(/databases/$(database)/documents/examConfig/current).data.get('mock1EndAt', null))
              || (request.resource.data.get('mode', '') == 'mock2' && request.resource.data.get('endAt', null) == get(/databases/$(database)/documents/examConfig/current).data.get('mock2EndAt', null))
              || (request.resource.data.get('mode', '') == 'main' && request.resource.data.get('endAt', null) == get(/databases/$(database)/documents/examConfig/current).data.get('mainEndAt', null))
            )
          )
        );

      allow update: if examOwner() || (
        isOwnSession()
        && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('mode', '') == resource.data.get('mode', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'name', 'mode', 'status', 'currentQuestion',
          'totalQuestions', 'tabSwitches', 'endAtMs', 'updatedAt',
          'startedAt', 'lateEntryRequested', 'requestedAt',
          'reentryGrantConsumedAt', 'kickedAt', 'reason', 'submittedAt'
        ])
        && request.resource.data.get('endAt', null) == resource.data.get('endAt', null)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.get('status', '') in ['kicked', 'submitted']
          || (
            request.resource.data.get('status', '') == 'late_request'
            && request.resource.data.get('lateEntryRequested', false) == true
          )
          || (
            request.resource.data.get('status', '') == 'active'
            && resource.data.get('status', '') == 'active'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lateEntryRequested'])
          || request.resource.data.get('lateEntryRequested', false) == true
          || request.resource.data.get('status', '') == 'active'
        )
      );

      allow delete: if examOwner();
    }

    match /admitCards/{cardId} {
      // Students can only read their own card after the per-card release flag,
      // or the global release for legacy cards without an exam-specific type.
      allow read: if examOwner() || (
        signedIn()
        && (
          resource.data.get('studentUid', '') == request.auth.uid
          || resource.data.get('uid', '') == request.auth.uid
        )
        && (
          resource.data.get('admitCardReleased', false) == true
          || (
            resource.data.get('admitCardExamType', '') == ''
            && exists(/databases/$(database)/documents/examConfig/current)
            && get(/databases/$(database)/documents/examConfig/current).data.get('admitCardReleased', false) == true
          )
        )
      );
      allow create, update, delete: if examOwner();
    }

    match /userAccessLogs/{id} {
      allow create: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid;
      allow read, update, delete: if owner();
    }

    match /feedbacks/{id} {
      allow create: if signedIn();
      allow read, update, delete: if owner();
    }

    match /notifications/{id} {
      allow read: if true;

      allow create: if canSendNotifications()
        && request.resource.data.get('title', null) is string
        && request.resource.data.get('message', null) is string
        && request.resource.data.get('audience', '') == 'all'
        && request.resource.data.get('active', false) == true
        && request.resource.data.get('createdBy', '') == request.auth.uid;

      allow update, delete: if canSendNotifications();
    }

    match /userNotifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.get('uid', '') in ['ALL', request.auth.uid];

      allow create: if examOwner()
        && request.resource.data.keys().hasOnly([
          'uid', 'type', 'title', 'body', 'important',
          'pinnedByOwner', 'fileUrl', 'createdAt'
        ])
        && request.resource.data.get('uid', '') is string
        && request.resource.data.get('uid', '').size() <= 128
        && request.resource.data.get('type', '') is string
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('body', '') is string
        && request.resource.data.get('important', false) is bool
        && request.resource.data.get('pinnedByOwner', false) is bool;

      allow update, delete: if examOwner();
    }

    match /notificationReads/{markerId} {
      allow read: if signedIn() && resource.data.get('uid', '') == request.auth.uid;

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'notificationId', 'read', 'readAt'
        ])
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('notificationId', '') is string
        && request.resource.data.get('read', false) == true;

      allow delete: if false;
    }

    match /userNotifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if (
        canSendNotifications()
        && request.resource.data.get('recipientUid', '') == uid
      ) || (
        canReviewExam()
        && request.resource.data.get('type', '') == 'exam-result'
        && request.resource.data.get('recipientUid', '') == uid
      ) || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.get('recipientUid', '') == uid
        && request.resource.data.get('type', '') in ['quiz-result', 'exam-start']
        && request.resource.data.get('active', false) == true
      );

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'isRead']);

      allow delete: if examOwner();
    }

    match /userNotificationReads/{uid}/items/{notificationId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Enforce community maintenance at the database boundary too. Clients cannot
    // bypass a posting lock by calling Firestore directly instead of the UI.
    // Global maintenance conservatively blocks writes for all clients because
    // Firestore rules cannot reliably identify the caller's device type.
    function communityPostingAllowed() {
      let maintenancePath = /databases/$(database)/documents/settings/maintenance;
      // A community posting/full-section lock is absolute: no user, owner or editor may post.
      // Global maintenance may still honor the configured owner bypass when community itself is open.
      return !exists(maintenancePath)
        || (
          get(maintenancePath).data.get('sections', {}).get('community', 'off') == 'off'
          && (
            get(maintenancePath).data.get('globalMode', 'off') == 'off'
            || (
              get(maintenancePath).data.get('vipBypass', true) == true
              && owner()
            )
          )
        );
    }

    match /communityBlocks/{uid} {
      allow read: if owner() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if owner();
    }

    function communityUserNotBlocked(uid) {
      let blockPath = /databases/$(database)/documents/communityBlocks/$(uid);
      return !exists(blockPath) || get(blockPath).data.get('blocked', false) != true;
    }

    match /posts/{id} {
      allow read: if true;

      allow create: if signedIn()
        && communityUserNotBlocked(request.auth.uid)
        && communityPostingAllowed()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('body', null) is string
        && request.resource.data.body.size() <= 2000;

      allow update: if owner();

      allow delete: if owner()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }

    match /audios/{id} {
      allow read: if true;
      allow write: if canManageMedia();
    }

    match /pdfs/{id} {
      allow read: if true;
      allow write: if canManageMedia();
    }

    match /shabadwani/{id} {
      allow read: if true;
      allow write: if canManageMedia();
    }

    match /treePledges/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.get('uid', '') == request.auth.uid;
      allow delete: if owner();
    }

    match /stats/{id} {
      allow read: if true;
      allow write: if owner();
    }

    match /visitorLogs/{id} {
      allow create: if true;
      allow read, update, delete: if owner();
    }

    match /draftQueue/{id} {
      allow read, write: if owner();
    }

    match /scheduledTasks/{id} {
      allow read, write: if owner();
    }

    match /historyItems/{id} {
      allow read: if true;
      allow create, update, delete: if owner();
    }

    match /platform_media/{mediaId} {
      allow get, list: if canManageMedia() || resource.data.get('active', false) == true;

      allow create: if canManageMedia()
        && request.resource.data.keys().hasOnly([
          'title', 'type', 'category', 'url', 'videoId', 'driveId', 'previewUrl',
          'active', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('title', '') is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.get('type', '') in ['youtube', 'pdf', 'audio']
        && request.resource.data.get('category', 'literature') in ['bhajan', 'katha', 'history', 'literature']
        && request.resource.data.get('url', '') is string
        && request.resource.data.get('active', false) == true
        && request.resource.data.get('createdBy', '') == request.auth.uid;

      allow update: if canManageMedia()
        && request.resource.data.get('createdBy', resource.data.get('createdBy', '')) == resource.data.get('createdBy', '')
        && request.resource.data.get('title', '') is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180;

      allow delete: if canManageMedia();
    }

    match /live_violations/{violationId} {
      allow create: if signedIn()
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('mode', '') in ['quiz', 'mock1', 'mock2', 'main']
        && request.resource.data.get('type', '') in ['tab_switch', 'fullscreen_exit']
        && request.resource.data.keys().hasOnly([
          'uid', 'mode', 'name', 'rollNumber', 'studentPhone',
          'type', 'detail', 'occurredAtMs', 'createdAt'
        ])
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('rollNumber', '') is string
        && request.resource.data.get('rollNumber', '').size() <= 40
        && request.resource.data.get('studentPhone', '') is string
        && request.resource.data.get('studentPhone', '').size() <= 20
        && request.resource.data.get('detail', '') is string
        && request.resource.data.get('detail', '').size() <= 240
        && request.resource.data.get('occurredAtMs', 0) is int;

      allow read: if examOwner();
      allow update, delete: if owner();
    }

    match /roleAuditLogs/{eventId} {
      allow read: if examOwner();

      allow create: if examOwner()
        && request.resource.data.keys().hasOnly([
          'action', 'targetName', 'targetPhoneLast4', 'targetRole',
          'permissions', 'changedByName', 'changedAt'
        ])
        && request.resource.data.get('action', '') in [
          'invitation_created', 'editor_removed',
          'invitation_revoked', 'invitation_reinvited'
        ]
        && request.resource.data.get('targetName', '') is string
        && request.resource.data.get('targetName', '').size() <= 100
        && request.resource.data.get('targetPhoneLast4', '') is string
        && (
          request.resource.data.get('targetPhoneLast4', '') == ''
          || request.resource.data.get('targetPhoneLast4', '').matches('^[0-9]{4}$')
        )
        && request.resource.data.get('targetRole', '') == 'editor'
        && request.resource.data.get('permissions', {}) is map
        && request.resource.data.get('changedByName', '') is string
        && request.resource.data.get('changedByName', '').size() <= 120
        && request.resource.data.get('changedAt', null) is timestamp;

      allow update, delete: if false;
    }

    match /publicAdmitCardVerifications/{token} {
      allow get: if resource.data.get('expiresAt', timestamp.date(1970, 1, 1)) is timestamp
        && resource.data.get('expiresAt', timestamp.date(1970, 1, 1)) > request.time;

      allow list: if false;

      allow create: if examOwner()
        && token.matches('^[a-f0-9]{48}$')
        && request.resource.data.keys().hasOnly([
          'rollNumber', 'examTitle', 'status', 'issuedAt', 'expiresAt'
        ])
        && request.resource.data.get('rollNumber', '') is string
        && request.resource.data.get('rollNumber', '').matches('^JAMBH-[0-9]{4}-[0-9]{4,}$')
        && request.resource.data.get('examTitle', '') is string
        && request.resource.data.get('examTitle', '').size() > 0
        && request.resource.data.get('examTitle', '').size() <= 120
        && request.resource.data.get('status', '') == 'valid'
        && request.resource.data.get('issuedAt', null) is timestamp
        && request.resource.data.get('expiresAt', null) is timestamp
        && request.resource.data.get('expiresAt', timestamp.date(1970, 1, 1)) > request.time;

      allow update, delete: if examOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
